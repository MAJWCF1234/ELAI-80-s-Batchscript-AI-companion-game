:triviachallenge_g_000326
@echo off
setlocal enabledelayedexpansion
REM Trivia questions and answers
set "questions[1]=What is the capital of France?^Paris"
set "questions[2]=Which planet is known as the Red Planet?^Mars"
set "questions[3]=What is the chemical symbol for gold?^Au"
set "questions[4]=Who wrote the play 'Romeo and Juliet'?^William Shakespeare"
set "questions[5]=Which famous scientist developed the theory of relativity?^Albert Einstein"
REM Initialize variables
set "current_question=1"
set "correct_answers=0"
set "total_questions=5"
echo Welcome to the Trivia Challenge! I'll ask you a series of questions, and you can respond with your answers. Let's get started!
:loop_g_000326
if !current_question! leq !total_questions! (
    set "current_answer="
    for /f "tokens=1,2 delims=^" %%a in ("!questions[!current_question!]!") do (
        set "current_question_text=%%a"
        set "correct_answer=%%b"
    )
    set /p "user_answer=!current_question_text! "
    if "!user_answer!" equ "!correct_answer!" (
        echo Correct! Great job!
        set /a correct_answers+=1
    ) else (
        echo That's not quite right. The correct answer is !correct_answer!.
    )
    set /a current_question+=1
    goto loop_g_000326
) else (
    echo You've completed the Trivia Challenge! You got !correct_answers! out of !total_questions! questions correct.
    exit /b 0
)
:creativewritingprompt_g_000331
@echo off
setlocal enabledelayedexpansion
REM Creative writing prompts
set "prompts[1]=Write a short story about a mysterious old book found in an attic."
set "prompts[2]=Imagine waking up with the ability to read minds for a day. What do you discover?"
set "prompts[3]=Describe a character's journey through a magical forest with enchanted creatures."
set "prompts[4]=Write a dialogue between an unusual pair: a human and a talking animal."
set "prompts[5]=Describe a futuristic cityscape where technology has taken over daily life."
REM Choose a random writing prompt
set /a prompt_index=!random! %% 5 + 1
for /f "tokens=1,* delims=^" %%a in ("!prompts[!prompt_index!]!") do (
    set "writing_prompt=%%a"
    set "feedback_prompt=%%b"
)
echo Welcome to the Creative Writing Prompt activity! I'm excited to help you unleash your creativity.
echo Here's your writing prompt: !writing_prompt!
echo Take a moment to write your response. When you're ready, press Enter.
REM Prompt for user's creative writing response
set /p "user_response="
REM Prompt user for a title for their story
set /p "story_title=Enter a title for your story: "
REM Prompt user for feedback style
echo.
echo How would you like feedback on your response?
echo 1. Encouragement
echo 2. Constructive Critique
set /p "feedback_choice=Enter the number of your choice: "
REM Process user's feedback choice
if "!feedback_choice!"=="1" (
    set "feedback_option=Keep up the great work and keep exploring your creativity!"
) else if "!feedback_choice!"=="2" (
    set "feedback_option=Your writing shows potential. Consider exploring more descriptive details and emotions."
) else (
    set "feedback_option=Thank you for sharing your creativity!"
)
REM Prompt user to save their writing
set /p "save_response=Do you want to save your writing to a text file? (Y/N): "
if /i "!save_response!"=="Y" (
    set "file_name=!story_title!.txt"
    echo !story_title! >> !file_name!
    echo -------------------------------- >> !file_name!
    echo. >> !file_name!
    echo !user_response! >> !file_name!
    echo. >> !file_name!
    echo Your writing has been saved in the file !file_name!.
) else (
    echo Your writing has not been saved. You can still refer to your creative piece above.
)
echo.
echo Thank you for sharing your creative writing! Here's a little feedback on your response: !feedback_option!
exit /b 0
:teach_helloworld_g_000332
@echo off
echo Welcome to the Batch Scripting Tutorial! Today, I'll show you how to create a simple "Hello, World!" batch script.
REM Step 1: Open a text editor (like Notepad) and create a new file.
REM Step 2: Type the following command in the file to display "Hello, World!" and save it as "hello.bat".
echo @echo off > hello.bat
echo echo Hello, World! >> hello.bat
REM Step 3: Close the text editor and double-click the "hello.bat" file to run the script.
REM Explanation:
REM - @echo off: This disables the display of each command in the script.
REM - echo Hello, World!: This command displays the text "Hello, World!".
echo Congratulations! You've created your first batch script that says "Hello, World!"
echo Now, you can open the folder containing the script and double-click it to see the output.
exit /b 0
:wordguessinggame
@echo off
setlocal enabledelayedexpansion
REM Secret word to guess
set "secret_word=computer"
REM Maximum number of incorrect guesses allowed
set /a max_attempts=6
REM Initialize variables
set "user_input="
set "attempts=0"
set "guessed_letters="
echo Welcome to the Word Guessing Game!
echo I'm thinking of a secret word. Can you guess what it is?
:guess_loop
REM Display guessed letters
if not "!guessed_letters!"=="" (
    echo Guessed letters: !guessed_letters!
)
echo Enter a letter to guess or type "exit" to quit: 
set /p "user_input="
REM Check if the user wants to quit
if /i "!user_input!"=="exit" (
    echo Thanks for playing the Word Guessing Game!
    exit /b 0
)
REM Check if the input is a single letter
set "valid_input=false"
for %%i in (a b c d e f g h i j k l m n o p q r s t u v w x y z) do (
    if /i "!user_input!"=="%%i" (
        set "valid_input=true"
        exit /b
    )
)
if "!valid_input!"=="true" (
    REM Check if the guessed letter is in the secret word
    set "guessed_correctly=false"
    for %%i in (!secret_word!) do (
        set "char=%%i"
        if /i "!user_input!"=="!char!" (
            set "guessed_correctly=true"
            set "guessed_letters=!guessed_letters!!char!"
        )
    )
    if "!guessed_correctly!"=="true" (
        echo Good guess! The letter is correct.
    ) else (
        echo Sorry, the letter is incorrect.
        set /a "attempts+=1"
    )
    if !attempts! lss !max_attempts! (
        echo You have !max_attempts! attempts remaining.
        goto guess_loop
    ) else (
        echo You've run out of attempts. The secret word was "!secret_word!".
    )
) else (
    echo Please enter a single letter or type "exit" to quit.
    goto guess_loop
)
exit /b 0
:numberguessinggame_g_000336
@echo off
setlocal enabledelayedexpansion
REM Set the range of numbers for the game (between 1 and 100)
set /a min_number=1
set /a max_number=100
REM Generate a random number for the user to guess
set /a secret_number=%random% %% (%max_number% - %min_number% + 1) + %min_number%
REM Maximum number of attempts allowed
set /a max_attempts=10
REM Initialize variables
set "user_input="
set "attempts=0"
echo Welcome to the Number Guessing Game!
echo I'm thinking of a number between %min_number% and %max_number%. Can you guess what it is?
:number_guess_loop
echo Enter your guess: 
set /p "user_input="
REM Check if the user's guess is a valid number
set "valid_input=true"
for %%i in (!user_input!) do (
    if not "%%i"=="!user_input!" (
        set "valid_input=false"
        goto invalid_input
    )
)
REM Compare the user's guess with the secret number
if %user_input% lss %secret_number% (
    echo Your guess is too low. Try a higher number.
) else if %user_input% gtr %secret_number% (
    echo Your guess is too high. Try a lower number.
) else (
    echo Congratulations! You've guessed the correct number: %secret_number%.
    exit /b 0
)
:invalid_input
if "%valid_input%"=="false" (
    echo Please enter a valid number.
)
REM Increment the attempts counter
set /a "attempts+=1"
REM Check if the user has reached the maximum number of attempts
if %attempts% lss %max_attempts% (
    echo You have %max_attempts% attempts remaining.
    goto number_guess_loop
) else (
    echo Sorry, you've run out of attempts. The secret number was %secret_number%.
)
exit /b 0
:wordguessinggame_g_000339
@echo off
setlocal enabledelayedexpansion
REM Set the list of words for the game
set "word_list=apple banana cherry orange grape"
REM Choose a random word from the list
for %%i in (!word_list!) do (
    set "word=%%i"
    set /a "random_index=!random! %% 5"
    if !random_index! == 0 (
        set "target_word=!word!"
    )
)
REM Maximum number of attempts allowed
set /a max_attempts=5
REM Initialize variables
set "user_guess="
set "attempts=0"
echo Welcome to the Word Guessing Game!
echo I'm thinking of a fruit. Can you guess which one it is?
:word_guess_loop
echo Enter your guess: 
set /p "user_guess="
REM Check if the user's guess is correct
if /i "!user_guess!"=="!target_word!" (
    echo Congratulations! You've guessed the correct word: !target_word!.
    exit /b 0
) else (
    echo That's not the correct word. Keep guessing!
)
REM Increment the attempts counter
set /a "attempts+=1"
REM Check if the user has reached the maximum number of attempts
if %attempts% lss %max_attempts% (
    echo You have %max_attempts% attempts remaining.
    goto word_guess_loop
) else (
    echo Sorry, you've run out of attempts. The correct word was !target_word!.
)
exit /b 0
