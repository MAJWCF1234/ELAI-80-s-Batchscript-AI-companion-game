    if !random_index! == 0 (
        set "computer_choice=!choice!"
    )
)
REM Determine the game result
if "!user_choice!"=="!computer_choice!" (
    set "result=It's a tie!"
) else if "!user_choice!"=="rock" (
    if "!computer_choice!"=="scissors" (
        set "result=You win!"
    ) else (
        set "result=Computer wins!"
    )
) else if "!user_choice!"=="paper" (
    if "!computer_choice!"=="rock" (
        set "result=You win!"
    ) else (
        set "result=Computer wins!"
    )
) else if "!user_choice!"=="scissors" (
    if "!computer_choice!"=="paper" (
        set "result=You win!"
    ) else (
        set "result=Computer wins!"
    )
) else (
    set "result=Invalid choice. Please choose rock, paper, or scissors."
)
REM Display game result
echo You chose !user_choice!. Computer chose !computer_choice!.
echo !result!
exit /b 0
