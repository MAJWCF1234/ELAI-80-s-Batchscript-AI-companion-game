:unknown
echo I don't know how to respond to that.
echo Can you tell me 10 ways I could respond next time you say "%TALK%"? Y/N 
SET /P ANSWER=
if /I "%ANSWER:~0,1%" neq "Y" (
    echo Can you tell me 5 ways I could respond next time you say "%TALK%"? Y/N 
    SET /P ANSWER=
    if /I "%ANSWER:~0,1%" neq "Y" goto begin
    goto ADDNEW5
)
:ADDNEW10
set "LEARN_COUNT=10"
goto capture_learning
:capture_learning
echo Tell me %LEARN_COUNT% ways to respond to "%TALK%" and I will remember them.
if not exist "%ELAI_MEMORY_FILE%" >"%ELAI_MEMORY_FILE%" echo # Elai learned responses
for /l %%N in (1,1,%LEARN_COUNT%) do (
    set "LEARN_TEXT="
    set /p "LEARN_TEXT=Response %%N: "
    if defined LEARN_TEXT >>"%ELAI_MEMORY_FILE%" echo(!ROUTE!^|!LEARN_TEXT!
)
echo THANKS - I saved the responses outside the main game file.
goto begin
:ADDNEW5
set "LEARN_COUNT=5"
goto capture_learning
:learned_response
set "LEARNED_COUNT=0"
if exist "%ELAI_MEMORY_FILE%" for /f "tokens=1,* delims=|" %%A in ('findstr /b /c:"%ROUTE%|" "%ELAI_MEMORY_FILE%" 2^>nul') do (
    set /a LEARNED_COUNT+=1
    set "LEARNED[!LEARNED_COUNT!]=%%B"
)
if !LEARNED_COUNT! LEQ 0 exit /b 1
set /a LEARNED_PICK=!RANDOM! %% LEARNED_COUNT + 1
for %%N in (!LEARNED_PICK!) do echo !LEARNED[%%N]!
exit /b 0
:builtin_response
for /f "tokens=1,* delims=|" %%A in ('findstr /b /i /c:"::%ROUTE%|" "%~f0" 2^>nul') do (
    echo %%B
    exit /b 0
)
exit /b 1
