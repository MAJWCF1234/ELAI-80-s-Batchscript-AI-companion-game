:numbersort
cls
echo ====================
echo     Number Sorter
echo ====================
echo.
echo Enter a list of numbers separated by spaces:
set /p numbers="> "
rem Split the input into an array
setlocal enabledelayedexpansion
set i=0
for %%n in (%numbers%) do (
    set /a i+=1
    set "num[!i!]=%%n"
)
rem Perform bubble sort
set /a n=%i%
for /L %%i in (1,1,%n%) do (
    for /L %%j in (1,1,%n% - %%i) do (
        set /a k=%%j + 1
        if !num[%%j]! gtr !num[!k!]! (
            set /a temp=!num[%%j]!
            set "num[%%j]=!num[!k!]!"
            set "num[!k!]=!temp!"
        )
    )
)
echo Sorted numbers in ascending order:
for /L %%i in (1,1,%i%) do (
    echo !num[%%i]!
)
echo.
pause
cls
exit /B 0
