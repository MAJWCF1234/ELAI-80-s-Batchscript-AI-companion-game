set message=H
set "message=!message!e"
set "message=!message!l"
set "message=!message!l"
set "message=!message!o"
set "message=!message!,"
set "message=!message! "
set "message=!message!W"
set "message=!message!o"
set "message=!message!r"
set "message=!message!l"
set "message=!message!d"
set "message=!message!!"
REM Showcasing the completed 'message'
