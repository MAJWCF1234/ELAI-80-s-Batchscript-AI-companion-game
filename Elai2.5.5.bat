echo Press any key to continue.
pause >nul
goto chapter1_g_0000014
:chapter1_g_0000014
cls
echo Chapter 1: Loss
echo ----------------
echo.
echo As you process the news of Dr. Wilson's death, you experience a deep sense of sadness and loss.
