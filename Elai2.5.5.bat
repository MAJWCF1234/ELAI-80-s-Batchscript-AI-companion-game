:LoadingScreen
setlocal EnableDelayedExpansion
set "fullbar=####################"
set "emptybar=                    "
for /l %%P in (0,5,100) do (
    set /a "filled=%%P/5"
    set /a "empty=20-filled"
    set /a "dots=(%%P/5) %% 4 + 3"
    set "loading=Loading"
    for /l %%D in (1,1,!dots!) do set "loading=!loading!."
    for /f "tokens=1,2" %%A in ("!filled! !empty!") do (
        set "filledbar=!fullbar:~0,%%A!"
        set "remaining=!emptybar:~0,%%B!"
    )
    cls
    echo !loading!
    echo      [!filledbar!!remaining!] %%P%%
    if %%P LSS 15 (
        timeout /t 2 /nobreak >nul
    ) else (
        timeout /t 1 /nobreak >nul
    )
)
for %%M in (
    "Booting up ELAI System..."
    "Checking Memory..."
    "Checking Processor..."
    "Checking Storage..."
    "Checking Connections..."
) do (
    cls
    echo %%~M
    timeout /t 1 /nobreak >nul
)
cls
echo ELAI System Booted Up Successfully!
timeout /t 2 /nobreak >nul
endlocal
exit /b 0
:playaudio
if exist "%~dp0%~1" (
    echo Playing audio file "%~1"...
    start "" /min /B "%~dp0%~1"
) else (
    echo Audio file "%~1" not found.
)
exit /b 0
